# --- Database (local docker compose) ---
# Runtime role: non-superuser, subject to RLS
DATABASE_URL=postgres://arena_app:arena_app@localhost:5432/arena
# Admin role: migrations + seed only (bypasses RLS). Never used by request handlers.
DATABASE_URL_ADMIN=postgres://arena:arena@localhost:5432/arena
APP_DB_PASSWORD=arena_app

# --- Redis / storage / mail ---
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=arena
S3_SECRET_KEY=arena-secret-key
S3_BUCKET=arena
EMAIL_SERVER=smtp://localhost:1025
EMAIL_FROM="Arena OS <no-reply@arena.local>"

# --- Auth.js ---
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Optional OAuth providers (buttons appear only when both values are set)
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# DEV ONLY: enables a passwordless "demo login" for seeded users. Refuses to run when NODE_ENV=production.
ENABLE_DEV_LOGIN=true

# --- Security ---
# 32 bytes, base64. Master key for envelope encryption (contracts, provider tokens).
MASTER_KEY=
